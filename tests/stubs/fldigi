#!/usr/bin/env python3
"""Stand-in for `fldigi` used by the test suite.

Behaves like the real thing in the ways the launchers depend on: it is started
with --config-dir DIR/ and --xmlrpc-server-port PORT, serves XML-RPC on that
port (including the handful of modem/main calls the launchers make), starts the FLAMP and Prog 1 (FLMSG) autostart programs named in
DIR/fldigi_def.xml, and exits when told to over XML-RPC (fldigi.terminate).
It records the PulseAudio devices it was given (PULSE_SOURCE/PULSE_SINK) in
DIR/stub-audio.txt. Like the real program it dies on SIGHUP.
"""
import os
import re
import subprocess
import sys
import threading
from xmlrpc.server import SimpleXMLRPCServer

args = sys.argv[1:]
def opt(name):
    return args[args.index(name) + 1] if name in args else None

cfg = opt("--config-dir") or sys.exit("stub fldigi: no --config-dir")
port = int(opt("--xmlrpc-server-port") or 7362)
xml = open(os.path.join(cfg, "fldigi_def.xml")).read()
def setting(key):
    m = re.search(r"^<%s>(.*)</%s>$" % (key, key), xml, re.M)
    return m.group(1) if m else ""

with open(os.path.join(cfg, "stub-audio.txt"), "w") as f:
    f.write("%s %s\n" % (os.environ.get("PULSE_SOURCE", ""), os.environ.get("PULSE_SINK", "")))

for path_key, enable_key in (("AUTO_FLAMP_PATHNAME", "FLAMP_AUTO_ENABLE"), ("AUTO_PROG1_PATHNAME", "PROG1_AUTO_ENABLE")):
    if setting(enable_key) == "1" and setting(path_key):
        subprocess.Popen(setting(path_key), shell=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

srv = SimpleXMLRPCServer(("127.0.0.1", port), logRequests=False, allow_none=True)
def terminate(_flags):
    threading.Timer(0.2, lambda: os._exit(0)).start()
    return None
srv.register_function(terminate, "fldigi.terminate")

# Modem and main-window state. TxID starts ON, as the real FLDIGI can, despite its settings.
st = {"modem": "BPSK31", "carrier": 1500, "afc": True, "reverse": False, "txid": True, "rsid": True}
def setter(key):
    def f(v):
        st[key] = v
        return None
    return f
for name, fn in (
        ("fldigi.version", lambda: "stub"),
        ("modem.set_by_name", setter("modem")), ("modem.get_name", lambda: st["modem"]),
        ("modem.set_carrier", setter("carrier")), ("modem.get_carrier", lambda: st["carrier"]),
        ("main.set_afc", setter("afc")), ("main.get_afc", lambda: st["afc"]),
        ("main.set_reverse", setter("reverse")), ("main.get_reverse", lambda: st["reverse"]),
        ("main.set_txid", setter("txid")), ("main.get_txid", lambda: st["txid"]),
        ("main.set_rsid", setter("rsid")), ("main.get_rsid", lambda: st["rsid"]),
        ("text.clear_rx", lambda: None)):
    srv.register_function(fn, name)
srv.serve_forever()
