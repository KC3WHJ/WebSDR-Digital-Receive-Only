#!/usr/bin/env bash
# Start a receive-only station fed by SDRangel (its KiwiSDR input) instead of a browser tab.
#
#   sdrangel-rx-start js8      JS8Call + CommStat
#   sdrangel-rx-start fldigi   FLDIGI + FLMSG + FLAMP
#
# (sdrangel-js8-start / sdrangel-fldigi-start are shortcuts for these.)
#
# Order matters:
#   1. websdr-<mode>-start --no-route  creates that station's virtual audio device and starts
#                                       its programs
#   2. SDRangel                         must start AFTER step 1: it lists audio devices only
#                                       when it starts, so it couldn't pick the new device
#   3. Point SDRangel's SSB demodulator at that device and start the KiwiSDR stream, through
#      SDRangel's REST API (127.0.0.1:8091)
#   4. A speaker loopback, so you hear what the decoder hears
#
# One station at a time: SDRangel's demodulator feeds one decoder, so starting one mode stops
# the other first. Stop with sdrangel-rx-stop <mode>.
#
# Before the first use, add a KiwiSDR device in SDRangel (it remembers it) - see docs/USAGE.md.
#
# Environment: SDRANGEL_LISTEN=0 turns the loopback off; SDRANGEL_LISTEN_GAIN (default 30dB)
# sets how loud it is. SDRANGEL_API, SDRANGEL_BIN and SDRANGEL_LOOP_NAME are for testing.
set -u

_self="$(readlink -f "${BASH_SOURCE[0]}")"
_here="$(dirname "$_self")"
APP=""
for c in "${WEBSDR_JS8_APP_DIR:-}" "$_here/.." "${XDG_DATA_HOME:-$HOME/.local/share}/websdr-js8/app"; do
    [ -n "$c" ] && [ -f "$c/lib/common.sh" ] && { APP="$(cd "$c" && pwd)"; break; }
done
[ -n "$APP" ] || { echo "ERROR: can't find WebSDR-Digital-Receive-Only's lib/ - has it been installed? (run install.sh)" >&2; exit 1; }
# shellcheck source=../lib/common.sh
. "$APP/lib/common.sh"
load_config

MODE="${1:-}"
case "$MODE" in
    js8)    CABLE="$SINK";    APPNAME="JS8Call"; OTHER=fldigi
            AFTER="JS8Call should start decoding within a cycle or two."
            BANDNOTE="if you change band in SDRangel, change JS8Call's dial frequency to match." ;;
    fldigi) CABLE="$FL_SINK"; APPNAME="FLDIGI";  OTHER=js8
            AFTER="Signals should show on FLDIGI's waterfall."
            BANDNOTE="FLDIGI has no rig control here: type SDRangel's frequency into FLDIGI's frequency box so its log and RSID show the right dial." ;;
    -h|--help) sed -n '2,25p' "$_self" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Usage: sdrangel-rx-start js8|fldigi" >&2; exit 2 ;;
esac
STATION="$_here/websdr-$MODE-start"
[ -x "$STATION" ] || die "$STATION isn't installed (was the $APPNAME station left out at install time?)."
SDR_BIN="${SDRANGEL_BIN:-sdrangel}"
SDR_PAT="(^|/)$SDR_BIN( |\$)"
API="${SDRANGEL_API:-http://127.0.0.1:8091/sdrangel}"
LISTEN="${SDRANGEL_LISTEN:-1}"
LISTEN_GAIN="${SDRANGEL_LISTEN_GAIN:-30dB}"
LOOP_NAME="${SDRANGEL_LOOP_NAME:-SDRangel-monitor}"
LOG="$DATA_DIR/sdrangel.log"

have "$SDR_BIN" || die "SDRangel isn't installed (see docs/USAGE.md, \"SDRangel instead of a browser\")."
have curl       || die "curl isn't installed (sudo apt install curl)."
have pactl      || die "pactl isn't installed (sudo apt install pulseaudio-utils)."
api() { curl -s -m 5 "$@"; }
sdr_running() { pgrep -f "$SDR_PAT" >/dev/null 2>&1; }
jget() { python3 -I -c 'import json, sys
d = json.load(sys.stdin)
for k in sys.argv[1:]:
    d = d[int(k)] if isinstance(d, list) else d[k]
print(d)' "$@" 2>/dev/null; }

# One station at a time. Stopping the other one also closes SDRangel, which has to restart
# anyway to see this station's audio device.
js8_up()    { pgrep -f "(^|/)js8call -r $PROFILE( |\$)" >/dev/null 2>&1 || sink_module_loaded "$SINK"; }
fldigi_up() { pgrep -f "fldigi --config-dir $FLDIGI_DIR/" >/dev/null 2>&1 || sink_module_loaded "$FL_SINK"; }
if "${OTHER}_up"; then
    step "The receive-only $([ "$OTHER" = js8 ] && echo JS8Call || echo FLDIGI) station is running - stopping it first"
    "$_here/sdrangel-rx-stop" "$OTHER" || die "couldn't stop it."
fi

step "Step 1/3: receive-only $APPNAME station"
"$STATION" --no-route || die "$STATION failed."

step "Step 2/3: SDRangel"
if sdr_running; then
    api "$API/audio" | grep -q "\"$CABLE\"" \
        || die "SDRangel was already open before the $APPNAME station started, so it can't see the '$CABLE' audio device.
  Close SDRangel (File > Exit, or sdrangel-rx-stop) and start this again."
    info "Already running."
else
    mkdir -p "$DATA_DIR"
    setsid -f nohup "$SDR_BIN" >"$LOG" 2>&1 </dev/null
    info "Started. Waiting for it to finish loading..."
    for _ in $(seq 1 60); do api "$API" >/dev/null && break; sleep 1; done
    api "$API" >/dev/null || die "SDRangel didn't answer on its REST API in 60 s - see $LOG"
    sleep 2   # let it finish restoring the saved device and channel
fi

step "Step 3/3: SDRangel's audio into $APPNAME, and the KiwiSDR stream"
read -r HW CHIDX < <(api "$API/devicesets" | python3 -I -c '
import json, sys
try:
    d = json.load(sys.stdin)["deviceSets"]
except Exception:
    print("unreachable -1"); sys.exit()
if not d:
    print("none -1"); sys.exit()
ds = d[0]
hw = ds.get("samplingDevice", {}).get("hwType", "none")
idx = next((c["index"] for c in ds.get("channels", []) if c.get("id") == "SSBDemod"), -1)
print(hw, idx)')
[ "$HW" = "KiwiSDR" ] || die "SDRangel's first device is '$HW', not KiwiSDR. In SDRangel add a KiwiSDR receiver
  (the + Add Rx device button), enter a server (host:8073), then start this again."

if [ "$CHIDX" = "-1" ]; then
    info "No SSB demodulator yet - adding one (USB 300-3000 Hz, AGC on, volume 0.15)."
    api -X POST "$API/deviceset/0/channel" -H 'Content-Type: application/json' \
        -d '{"channelType":"SSBDemod","direction":0}' >/dev/null
    sleep 2
    CHIDX="$(api "$API/devicesets" | python3 -I -c '
import json, sys
ch = json.load(sys.stdin)["deviceSets"][0].get("channels", [])
print(next((c["index"] for c in ch if c.get("id") == "SSBDemod"), -1))' 2>/dev/null)"
    [ "${CHIDX:--1}" = "-1" ] && die "couldn't add the SSB demodulator."
    # AGC on with a low volume: about 38 dB on JS8Call's meter. AGC off at full volume clips.
    SETTINGS="{\"audioDeviceName\":\"$CABLE\",\"agc\":1,\"volume\":0.15,\"rfBandwidth\":3000,\"lowCutoff\":300,\"inputFrequencyOffset\":0}"
else
    # An existing demodulator: only point it at this station; your volume and filter are kept.
    SETTINGS="{\"audioDeviceName\":\"$CABLE\"}"
fi
api -X PATCH "$API/deviceset/0/channel/$CHIDX/settings" -H 'Content-Type: application/json' \
    -d "{\"channelType\":\"SSBDemod\",\"direction\":0,\"SSBDemodSettings\":$SETTINGS}" \
    | grep -q "\"$CABLE\"" || die "couldn't set the demodulator's audio output to $CABLE."
info "SSB demodulator audio -> $CABLE ($APPNAME)."

api "$API/deviceset/0/device/run" | grep -q running || api -X POST "$API/deviceset/0/device/run" >/dev/null
DEV="$(api "$API/deviceset/0/device/settings")"
SERVER="$(jget kiwiSDRSettings serverAddress <<<"$DEV")"
FREQ="$(jget kiwiSDRSettings centerFrequency <<<"$DEV")"
info "Connecting to ${SERVER:-?} at $(( ${FREQ:-0} / 1000 )) kHz..."
STATUS=0
for _ in $(seq 1 15); do
    STATUS="$(api "$API/deviceset/0/device/report" | jget kiwiSDRReport status)"
    [ "$STATUS" = 2 ] && break; sleep 1
done
case "$STATUS" in
    2) info "Connected. $AFTER" ;;
    3) warn "the KiwiSDR reports an error. Try another server (host:8073) in SDRangel's KiwiSDR panel." ;;
    4) warn "the KiwiSDR server dropped the connection (full, or a time limit?). Try another server." ;;
    *) warn "still not connected (status ${STATUS:-?}). Check the KiwiSDR panel in SDRangel." ;;
esac

if [ "$LISTEN" = 1 ]; then
    step "Speaker loopback (so you hear it too)"
    loop_id() { pactl list sink-inputs | awk -v n="$LOOP_NAME" '/^Sink Input #/{id=substr($3,2)} index($0, "media.name = \"" n "\""){print id; exit}'; }
    # A loopback left on the other station's device (after switching modes) is replaced.
    for m in $(pactl list modules short | awk -v n="$LOOP_NAME" -v s="$CABLE.monitor" '$2=="module-loopback" && index($0, "media.name=" n) && !index($0, "source=" s " ") {print $1}'); do
        pactl unload-module "$m"
    done
    if [ -z "$(loop_id)" ]; then
        pactl load-module module-loopback source="$CABLE.monitor" latency_msec=100 source_dont_move=true \
            sink_input_properties=media.name="$LOOP_NAME" >/dev/null \
            || warn "couldn't create the speaker loopback ($APPNAME is unaffected)."
        sleep 1
    fi
    ID="$(loop_id)"
    if [ -n "$ID" ]; then
        # The decoder gets a deliberately quiet signal, so the loopback gets its own boost.
        pactl set-sink-input-volume "$ID" "$LISTEN_GAIN"
        info "Playing through your speakers (gain $LISTEN_GAIN). Adjust or mute '$LOOP_NAME' in the sound"
        info "mixer; that only changes what you hear, not what $APPNAME gets."
    fi
fi

echo
info "Remember: $BANDNOTE"
info "Stop everything with: sdrangel-$MODE-stop (or its icon)."
