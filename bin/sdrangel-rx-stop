#!/usr/bin/env bash
# Stop an SDRangel-fed receive-only station.
#
#   sdrangel-rx-stop js8      closes SDRangel, then runs websdr-js8-stop
#   sdrangel-rx-stop fldigi   closes SDRangel, then runs websdr-fldigi-stop
#
# Order matters (the reverse of start):
#   1. Close SDRangel the normal way (like clicking its X) so it saves its settings, BEFORE
#      the virtual audio device it plays into is removed
#   2. Remove the speaker loopback
#   3. websdr-<mode>-stop stops that station's programs and removes its devices
set -u

_self="$(readlink -f "${BASH_SOURCE[0]}")"
_here="$(dirname "$_self")"
APP=""
for c in "${WEBSDR_JS8_APP_DIR:-}" "$_here/.." "${XDG_DATA_HOME:-$HOME/.local/share}/websdr-js8/app"; do
    [ -n "$c" ] && [ -f "$c/lib/common.sh" ] && { APP="$(cd "$c" && pwd)"; break; }
done
[ -n "$APP" ] || { echo "ERROR: can't find WebSDR-Digital-Receive-Only's lib/ - has it been installed?" >&2; exit 1; }
# shellcheck source=../lib/common.sh
. "$APP/lib/common.sh"
load_config

MODE="${1:-}"
case "$MODE" in
    js8|fldigi) ;;
    -h|--help) sed -n '2,12p' "$_self" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Usage: sdrangel-rx-stop js8|fldigi" >&2; exit 2 ;;
esac
SDR_PAT="(^|/)${SDRANGEL_BIN:-sdrangel}( |\$)"
LOOP_NAME="${SDRANGEL_LOOP_NAME:-SDRangel-monitor}"

step "Step 1/3: closing SDRangel (so it saves its settings)"
if pgrep -f "$SDR_PAT" >/dev/null 2>&1; then
    # Close its windows by process id (wmctrl), the same as clicking the X.
    closed=0
    if have wmctrl; then
        for pid in $(pgrep -f "$SDR_PAT"); do
            for w in $(wmctrl -lp 2>/dev/null | awk -v p="$pid" '$3==p {print $1}'); do
                wmctrl -i -c "$w" 2>/dev/null && closed=1
            done
        done
    fi
    [ "$closed" = 1 ] || pkill -TERM -f "$SDR_PAT" 2>/dev/null
    for _ in $(seq 1 20); do pgrep -f "$SDR_PAT" >/dev/null 2>&1 || break; sleep 1; done
    if pgrep -f "$SDR_PAT" >/dev/null 2>&1; then
        info "It didn't close in 20 s - stopping it (changes since its last save may be lost)."
        pkill -TERM -f "$SDR_PAT" 2>/dev/null; sleep 3
        pgrep -f "$SDR_PAT" >/dev/null 2>&1 && pkill -9 -f "$SDR_PAT" 2>/dev/null
    fi
    info "Closed."
else
    info "Not running."
fi

step "Step 2/3: removing the speaker loopback"
mods="$(pactl list modules short 2>/dev/null | awk -v n="$LOOP_NAME" '$2=="module-loopback" && index($0, "media.name=" n) {print $1}')"
if [ -n "$mods" ]; then
    for m in $mods; do pactl unload-module "$m" 2>/dev/null; done
    info "Removed."
else
    info "Not loaded."
fi

step "Step 3/3: the receive-only station"
"$_here/websdr-$MODE-stop"
